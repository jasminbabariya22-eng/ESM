02","modified_by":null,"modified_on":null,"is_active":0,"is_deleted":0,"risk_co_owner_id":0,"rd_risk_description_id":4622,"rd_risk_register_id":4964,"rd_risk_id":"FIN-0265","rd_risk_description":"Unauthorized and inappropriate user access (RC) may results in fraudulent (RE) and incorrect accounting (C ).","rd_inherent_risk_likelihood_id":4,"rd_inherent_risk_impact_id":3,"rd_mitigation":"SAP IT Team will provide the access control matrix of Finance module to Respective Functional Heads, Employees' access to SAP are reviewed on annual basis by the Respective Functional Heads and validated by CFO to ensure that there are proper access restriction and segregation of duties.\n\nAccess to the various System SAP modules is appropriately restricted, and Inactive or unauthorized users and roles are removed promptly by SAP IT Team based on notification by e-mail/termination information received from HR team.","rd_current_risk_likelihood_id":3,"rd_current_risk_impact_id":3,"rd_created_by":327,"rd_created_on":"2026-07-15T07:11:04.084178","rd_modified_by":null,"rd_modified_on":null,"rd_is_deleted":0,"inherent_color_str":"#FFA500","inherent_color_code":"4C","current_color_str":"#FFFF00","current_color_code":"3C","risk_owner_name":"priya@example.com@example.com","risk_status_name":"Open","function_head_approval_status_name":"Approved","risk_manager_approval_status_name":"Approved","risk_head_approval_status_name":"Approved","action_required":false},{"risk_register_id":4965,"risk_id":"FIN-0266","risk_name":"Inventory management","dept_id":6,"risk_owner_id":328,"financial_year":"2026-2027","risk_status":9,"risk_progress":"0","risk_function_head_approval_status":1,"risk_function_head_approval_remark":"APPROVED","risk_function_head_approval_on":"2026-07-15T07:11:03.755834","risk_function_head_approval_by":299,"risk_head_approval_status":1,"risk_head_approved_on":"2026-07-15T07:11:03.755834","risk_head_approval_remark":"APPROVED","risk_head_approval_by":36,"risk_manager_approval_status