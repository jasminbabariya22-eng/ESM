0211","rd_risk_description":"POs not approved as per Delegation of Authority (DoA) (RC) leading to excess procurement or procurement of substandard materials/services (RE) at a higher rate (C).","rd_inherent_risk_likelihood_id":3,"rd_inherent_risk_impact_id":4,"rd_mitigation":"- Framework Order - SAP is configured to restrict the creation of framework order exceeding the Annual rate contract value;\n- Purchase Order - SAP is configured to de-list the PO if any line item in the PO is greater than 200% of the PR value;\n- Framework order and Annual rate contracts are created in SAP when the rates are pre-fixed with the vendors, but the quantities are determined later based on requirements;\n- SAP has automated control for tracking the PO’s created against each PR item number. Single PR may have multiple PO in case of multiple vendors selected for different states etc.;\n- PO gets released as per released strategy defined in SAP as per DOA .","rd_current_risk_likelihood_id":3,"rd_current_risk_impact_id":4,"rd_created_by":285,"rd_created_on":"2026-07-08T10:25:43.686502","rd_modified_by":null,"rd_modified_on":null,"rd_is_deleted":0,"inherent_color_str":"#FFA500","inherent_color_code":"3D","current_color_str":"#FFA500","current_color_code":"3D","risk_owner_name":"jatin@example.com","risk_status_name":"Open","function_head_approval_status_name":" ","risk_manager_approval_status_name":" ","risk_head_approval_status_name":" ","action_required":false},{"risk_register_id":4869,"risk_id":"FIN-0212","risk_name":"Vendor management","dept_id":6,"risk_owner_id":286,"financial_year":"2026-2027","risk_status":9,"risk_progress":"0","risk_function_head_approval_status":null,"risk_function_head_approval_remark":null,"risk_function_head_approval_on":null,"risk_function_head_approval_by":null,"risk_head_approval_status":null,"risk_head_approved_on":null,"risk_head_approval_remark":null,"risk_head_approval_by":null,"risk_manager_approval_status":null,"risk_manager_approved_on":null,"risk_m