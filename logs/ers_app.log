n happens automatically in company accounts.","rd_current_risk_likelihood_id":2,"rd_current_risk_impact_id":3,"rd_created_by":326,"rd_created_on":"2026-07-15T07:11:04.092983","rd_modified_by":null,"rd_modified_on":null,"rd_is_deleted":0,"inherent_color_str":"#FFFF00","inherent_color_code":"3C","current_color_str":"#90EE90","current_color_code":"2C","risk_owner_name":"ramesh@example.com@example.com","risk_status_name":"Open","function_head_approval_status_name":"Approved","risk_manager_approval_status_name":"Approved","risk_head_approval_status_name":"Approved","action_required":false},{"risk_register_id":4967,"risk_id":"FIN-0268","risk_name":"PO approval as per DOA","dept_id":6,"risk_owner_id":328,"financial_year":"2026-2027","risk_status":9,"risk_progress":"0","risk_function_head_approval_status":1,"risk_function_head_approval_remark":"APPROVED","risk_function_head_approval_on":"2026-07-15T07:11:03.796332","risk_function_head_approval_by":299,"risk_head_approval_status":1,"risk_head_approved_on":"2026-07-15T07:11:03.796332","risk_head_approval_remark":"APPROVED","risk_head_approval_by":36,"risk_manager_approval_status":1,"risk_manager_approved_on":"2026-07-15T07:11:03.796332","risk_manager_approval_remark":"APPROVED","risk_manager_approval_by":9,"created_by":328,"created_on":"2026-07-15T07:11:03.788707","modified_by":null,"modified_on":null,"is_active":0,"is_deleted":0,"risk_co_owner_id":0,"rd_risk_description_id":4625,"rd_risk_register_id":4967,"rd_risk_id":"FIN-0268","rd_risk_description":"POs not approved as per Delegation of Authority (DoA) (RC) leading to excess procurement or procurement of substandard materials/services (RE) at a higher rate (C).","rd_inherent_risk_likelihood_id":4,"rd_inherent_risk_impact_id":3,"rd_mitigation":"- Framework Order - SAP is configured to restrict the creation of framework order exceeding the Annual rate contract value;\n- Purchase Order - SAP is configured to de-list the PO if any line item in the PO is greater than 200% of th